{
	"$schema": "https://turborepo.com/schema.json",
	"globalEnv": [
		"DATABASE_URL",
		"TURSO_AUTH_TOKEN",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"API_URL",
		"VITE_API_URL",
		"VITE_APP_URL",
		"VITE_MAINTENANCE",
		"VITE_APP_TITLE",
		"PORT",
		"LOG_LEVEL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"lint": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"check": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		}
	}
}
