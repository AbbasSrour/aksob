{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@aksob/templates/*": ["./src/*"]
		}
	},
	"include": ["./src/**/*.ts", "./src/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
