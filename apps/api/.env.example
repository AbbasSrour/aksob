# Environment
NODE_ENV="development"  # Options: development, production, test

# Server Configuration
# Use 4000 locally so the Vite app can run on 3000 (see apps/client/.env.example API_URL).
PORT=4000
LOG_LEVEL="info"  # Options: debug, info, warn, error

# Turso / SQLite Database
# For local development: creates local.db file
DATABASE_URL="file:local.db"
# For production: use Turso remote URL
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Auth
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
DEFAULT_ADMIN_PASSWORD="change-this-admin-password"
# Include every origin the admin UI is served from (comma-separated).
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173"


# Email (Resend)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# Media uploads via UploadThing
 UPLOADTHING_TOKEN=""

# AI Providers (optional — AI matching is opt-in)
# Embedding: Google Gemini (free tier, no credit card required)
# Get your API key at https://aistudio.google.com/apikey
AI_EMBEDDING_PROVIDER_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_EMBEDDING_PROVIDER_KEY="your-gemini-api-key"
AI_EMBEDDING_MODEL="gemini-embedding-001"

# LLM: OpenCode Zen (match ranking)
# Get your API key at https://opencode.ai/auth
AI_LLM_PROVIDER_URL="https://opencode.ai/zen/v1"
AI_LLM_PROVIDER_KEY="your-zen-api-key"
AI_LLM_MODEL="minimax-m2.5-free"

