{
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"~/*": ["app/*"],
			"@aksob/shared/*": ["../../packages/shared/src/*"]
		},
		"types": ["react/canary", "react-dom/canary", "@react-router/node"]
	},
	"include": ["app/**/*", "src/**/*", "react-router.config.ts", "vite.config.ts"],
	"exclude": ["node_modules", "build", ".react-router"]
}
