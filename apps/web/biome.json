{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"extends": ["../../biome.json"],
	"linter": {
		"rules": {
			"suspicious": {
				"noArrayIndexKey": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [".react-router/**/*.ts"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["app/**/*.css"],
			"css": {
				"parser": {
					"tailwindDirectives": true
				}
			}
		}
	]
}
